{
  "name": "arena-overlay",
  "version": "0.8.0",
  "description": "MTG Arena draft overlay with 17Lands stats",
  "author": "Rocketfish",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_ENV=development node scripts/start-electron.js\"",
    "build": "vite build",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "release": "node scripts/release.js",
    "preview": "vite preview",
    "test:draft": "node scripts/test-draft.js",
    "test": "node scripts/test-parser.js && node scripts/test-analyzer.js && node scripts/test-deckbuilder.js && node scripts/test-game.js"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.rocketfish.arena-overlay",
    "productName": "Arena Overlay",
    "copyright": "Copyright 2026 Rocketfish",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arena Overlay"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload*.js",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [],
    "publish": {
      "provider": "github",
      "owner": "rocketvish",
      "repo": "arena-overlay"
    }
  }
}
